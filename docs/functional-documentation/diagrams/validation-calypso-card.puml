@startuml validation-calypso-card
' Pastel background colors: red F5B7B1 (error), yellow F9E79F (no ticket), green ABEBC6 (success),
' purple D7BDE2 (mode), orange FAD7A0 (user interaction)
title Validation of a Calypso card

start

:Card presented;

if (Card personalized\nand not expired ?) then (No)
  :Invalid card;<<#F5B7B1>>
  stop
else (Yes)
endif

:Read the last event;

if (Card never loaded ?) then (Yes)
  :No valid ticket;<<#F9E79F>>
  stop
elseif (Last event of\na known version ?) then (No)
  :Invalid card;<<#F5B7B1>>
  stop
else (Yes)
endif

if (Validated less than\n1 minute ago ?) then (Yes)
  if (Previous session\nratified ?) then (Yes)
    :Invalid card\n(already validated);<<#F5B7B1>>
    stop
  else (No)
    :Ratification of the\nprevious session\n(no new deduction);
    :Validation completed;<<#ABEBC6>>
    stop
  endif
else (No)
endif

:List the usable tickets\nin priority order;

if (No usable ticket ?) then (Yes)
  :No valid ticket;<<#F9E79F>>
  stop
else (No)
endif

repeat
  if (Ticket of a\nknown version ?) then (No)
    :Invalid card;<<#F5B7B1>>
    stop
  else (Yes)
  endif
  if (Ticket expired ?) then (Yes -> marked expired)
  else (No)
    if (Multi-trip ticket\nwithout trips left ?) then (Yes -> marked expired)
    else (No)
      :Deduct 1 trip\n(Multi-trip ticket);

      :Write the validation event\n(date, time, location, ticket used);

      :End of the secure session;

      :Validation completed;<<#ABEBC6>>

      stop
    endif
  endif
repeat while (Next ticket ?)

:Write the updated priorities;

:End of the secure session;

:Expired ticket\nor no trip left;<<#F9E79F>>

stop

@enduml
