@startuml validation-calypso-card
title Validation of a Calypso card

start

:Card presentation;

if (Card personalized\nand not expired ?) then (No)
  :Invalid card;<<#red>>
  stop
else (Yes)
endif

:Read the last event;

if (Card never loaded ?) then (Yes)
  :No valid ticket;<<#yellow>>
  stop
elseif (Last event of\na known version ?) then (No)
  :Invalid card;<<#red>>
  stop
else (Yes)
endif

if (Validated less than\n1 minute ago ?) then (Yes)
  if (Previous session\ncompleted ?) then (Yes)
    :Invalid card\n(already validated);<<#red>>
    stop
  else (No)
    :Session recovery\n(no new debit);
    :Validation done;<<#green>>
    stop
  endif
else (No)
endif

:List the usable tickets\nin priority order;

if (No usable ticket ?) then (Yes)
  :No valid ticket;<<#yellow>>
  stop
else (No)
endif

repeat
  if (Ticket of a\nknown version ?) then (No)
    :Invalid card;<<#red>>
    stop
  else (Yes)
  endif
  if (Ticket expired ?) then (Yes -> marked expired)
  else (No)
    if (Multi-trip ticket\nwithout trips left ?) then (Yes -> marked expired)
    else (No)
      :Debit 1 trip\n(multi-trip ticket);

      :Write the validation event\n(date, time, location, ticket used);

      :End of the secure session;

      :Validation done;<<#green>>

      stop
    endif
  endif
repeat while (Next ticket ?)

:Write the updated priorities;

:End of the secure session;

:Expired ticket\nor no trip left;<<#yellow>>

stop

@enduml
