@startuml validation-calypso-card
' Nested tests: the exit (No, then branch, drawn on the left) stops, the normal flow (Yes, else branch,
' drawn on the right) contains the rest of the procedure.
' Pastel background colors: red F5B7B1 (error), yellow F9E79F (no ticket), green ABEBC6 (success),
' purple D7BDE2 (mode), orange FAD7A0 (user interaction)
title Validation of a Calypso card

start

:Card presented;

if (Card recognized?\n(supported application\nand file structure)) then (No)
  :Card not recognized;<<#F5B7B1>>
  stop
else (Yes)
  :Open the secure session\nand read the environment;

  if (Card personalized\nand not expired?) then (No)
    :Card rejected;<<#F5B7B1>>
    stop
  else (Yes)
    :Read the last event;

    if (Card loaded\nat least once?) then (No)
      :No valid ticket;<<#F9E79F>>
      stop
    else (Yes)
      if (Last event of\na known version?) then (No)
        :Card rejected;<<#F5B7B1>>
        stop
      else (Yes)
        if (Last validation more\nthan 1 minute ago, or previous\nsession interrupted?) then (No)
          :Card rejected\n(already validated);<<#F5B7B1>>
          stop
        else (Yes)
          if (Last validation more\nthan 1 minute ago?) then (No)
            :Validation completed\n(ratification of the interrupted\nprevious session, no new deduction);<<#ABEBC6>>
            stop
          else (Yes)
            :List the usable tickets\nin priority order;

            if (Usable tickets?) then (No)
              :No valid ticket;<<#F9E79F>>
              stop
            else (Yes)
              repeat
                if (Ticket of a\nknown version?) then (No)
                  :Card rejected;<<#F5B7B1>>
                  stop
                else (Yes)
                  if (Ticket still valid?) then (No -> marked expired)
                  else (Yes)
                    if (Season pass,\nor trips left?) then (No -> marked expired)
                    else (Yes)
                      :Deduct 1 trip\n(multi-trip ticket);

                      :Write the validation event\n(date, time, location, ticket used);

                      :End of the secure session;

                      :Validation completed;<<#ABEBC6>>

                      stop
                    endif
                  endif
                endif
              repeat while (Next ticket?) is (Yes) not (No)

              if (Tickets marked expired?) then (No)
                :No valid ticket;<<#F9E79F>>
                stop
              else (Yes)
                :Write the updated priorities;
                :End of the secure session;
                :Expired ticket\nor no trip left;<<#F9E79F>>
                stop
              endif
            endif
          endif
        endif
      endif
    endif
  endif
endif

@enduml
