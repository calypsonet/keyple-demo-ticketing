@startuml inspection
' Nested tests: the exit (No, then branch, drawn on the left) stops, the normal flow (Yes, else branch,
' drawn on the right) contains the rest of the procedure.
' Pastel background colors: red F5B7B1 (error), yellow F9E79F (no ticket), green ABEBC6 (success),
' purple D7BDE2 (mode), orange FAD7A0 (user interaction)
title Inspection

start

:Card presented;

if (Card recognized ?\n(supported Calypso application\nor storage card type)) then (No)
  :Not valid on this network;<<#F5B7B1>>
  stop
else (Yes)
  :Open the reading session\n(authentication: SAM,\nPKI or none);<<#D7BDE2>>

  if (Card personalized\nand not expired ?) then (No)
    :Not valid on this network;<<#F5B7B1>>
    stop
  else (Yes)
    :Read the last event;

    if (Card loaded\nat least once ?) then (No)
      :No ticket;<<#F9E79F>>
      stop
    else (Yes)
      if (Last event of\na known version ?) then (No)
        :Not valid on this network;<<#F5B7B1>>
        stop
      else (Yes)
        :Check the last validation\n(location, same day, validation period);

        :Read the tickets\nand their counters;

        if (Tickets of a\nknown version ?) then (No)
          :Not valid on this network;<<#F5B7B1>>
          stop
        else (Yes)
          :Status of each ticket\n(valid, expired, validated\nby the last validation);

          :End of the reading session;

          :Card content displayed;<<#ABEBC6>>

          stop
        endif
      endif
    endif
  endif
endif

@enduml
