@startuml inspection
title Inspection

start

:Card presented;

:Authentication mode\nSAM, PKI or none;<<#6a00ff>>

if (Card personalized\nand not expired ?) then (No)
  :Not valid on this network;<<#red>>
  stop
else (Yes)
endif

:Read the last event;

if (Card never loaded ?) then (Yes)
  :No ticket;<<#yellow>>
  stop
elseif (Last event of\na known version ?) then (No)
  :Not valid on this network;<<#red>>
  stop
else (Yes)
endif

:Check the last validation\n(location, same day, validation period);

:Read the tickets\nand their counters;

if (Tickets of a\nknown version ?) then (No)
  :Not valid on this network;<<#red>>
  stop
else (Yes)
endif

:Status of each ticket\n(valid, expired, validated\nby the last validation);

:End of the reading session;

:Card content displayed;<<#green>>

stop

@enduml
