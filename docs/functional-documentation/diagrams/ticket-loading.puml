@startuml ticket-loading
' Pastel background colors: red F5B7B1 (error), yellow F9E79F (no ticket), green ABEBC6 (success),
' purple D7BDE2 (mode), orange FAD7A0 (user interaction)
title Ticket loading

start

if (Server connected\nwith its SAM ?) then (No)
  :Server error;<<#F5B7B1>>
  stop
else (Yes)
endif

:Card presented;

if (Card personalized\nand not expired ?) then (No)
  :Card rejected;<<#F5B7B1>>
  stop
else (Yes)
endif

if (Last event of\na known version ?) then (No)
  :Card rejected;<<#F5B7B1>>
  stop
else (Yes)
endif

:Read the tickets\n(expired tickets identified);

:User choice\nof the ticket to load;<<#FAD7A0>>
note right: User interaction

if (Slot available ?\nsame type, empty or expired\n(single-ticket card: other ticket not usable)) then (No)
  :Card rejected;<<#F5B7B1>>
  stop
else (Yes)
endif

:Write the ticket\n(Season Pass renewal: +30 days if not expired);

:Add the trips to the counter\n(Multi-trip ticket);

if (Ticket priorities changed ?) then (Yes)
  :Update the priorities\nin the last event;
else (No)
endif

:End of the secure session\n(Calypso card);

:Ticket loaded;<<#ABEBC6>>

stop

@enduml
