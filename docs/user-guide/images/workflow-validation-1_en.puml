@startuml workflow-validation-1_en
title Validation Calypso card

start

:Card presentation;

if (EnvVersion=1 and\nEnvEndDate valid ?) then (No)
  :Invalid card;<<#red>>
  stop
else (Yes)
endif

:Read event SFI 0x08;

if (EventVersion == 0 ?) then (Yes)
  :Empty card;<<#yellow>>
  stop
elseif (EventVersion == 1 ?) then (No)
  :Invalid card;<<#red>>
  stop
else (Yes)
endif

if (Anti-passback\nΔt <= 1 min ?) then (Yes)
  if (Previous session ratified ?) then (Yes)
    :Invalid card\n(already validated);<<#red>>
    stop
  else (No)
    :Session closure\n(recovery, no new debit);
    :Validation done;<<#green>>
    stop
  endif
else (No)
endif

:Read priorities;

if (Empty list ?) then (Yes)
  :Empty card;<<#yellow>>
  stop
else (No)
endif

repeat
  if (ContractValidityEndDate\n≥ today ?) then (No -> priority 31)
  else (Yes)
    if (MULTI_TRIP and\nCounter == 0 ?) then (Yes -> priority 31)
    else (No)
      :Decrement counter\n(if MULTI_TRIP);

      :Write EventStructure\ndate - time - location - used contract;

      :Session closure;

      :Validation done;<<#green>>

      stop
    endif
  endif
repeat while (next contract)

:Write priorities\n(expired or exhausted contracts);

:Session closure;

:No valid ticket;<<#yellow>>

stop

@enduml
