@startuml workflow-validation-1_fr
title Validation carte Calypso

start

:Présentation carte;

if (EnvVersion=1 et\nEnvEndDate valide ?) then (Non)
  :Carte invalide;<<#red>>
  stop
else (Oui)
endif

:Lecture Événement SFI 0x08;

if (EventVersion == 1 ?) then (Non)
  :Carte invalide;<<#red>>
  stop
else (Oui)
endif

if (Anti-passback\nΔt > 1 min ?) then (Non)
  :Carte invalide;<<#red>>
  stop
else (Oui)
endif

:Collecte priorités;

if (Liste vide ?) then (Oui)
  :Carte vide;<<#yellow>>
  stop
else (Non)
endif

repeat
  if (ContractValidityEndDate\n≥ aujourd'hui ?) then (Non -> marquer expiré)
  else (Oui)
    if (Compteur\nsuffisant ?) then (Non -> contrat suivant)
    else (Oui)
      :Décrémentation compteur\n(si MULTI_TRIP / STORED_VALUE);

      :Écriture EventStructure\ndate - heure - lieu - contrat utilisé;

      :Fermeture session;

      :Validation terminée;<<#green>>

      stop
    endif
  endif
repeat while (contrat suivant)

@enduml
