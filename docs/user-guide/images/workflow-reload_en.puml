@startuml workflow-reload_en
title Reload

start

if (Connected to server\nand is SAM present ?) then (No)
  :Timeout exception;<<#red>>
  stop
else (Yes)
endif

:Card presentation;

if (EnvVersionNumber=1\nand EnvEndDate valid ?) then (No)
  :Card refused;<<#red>>
  stop
else (Yes)
endif

if (EventVersionNumber\n∈ {0, 1} ?) then (No)
  :Card refused;<<#red>>
  stop
else (Yes)
endif

:Read contracts 1 to 4\nDates verification + authenticators;

:User choice\nticket to load;<<#orange>>
note right: User interaction

if (Slot available ?\nsame type, empty or expired\n(single-ticket card: other ticket not usable)) then (No)
  :Card refused;<<#red>>
  stop
else (Yes)
endif

:Build ContractStructure\n(Season Pass renewal: +30 days if not expired);

:Write contract\n+ Increment counter if MULTI_TRIP;

if (ContractPriority changed ?) then (Yes)
  :Update EventStructure\n(ContractPriority 1 to 4);
else (No)
endif

:Session closure;

:Ticket loaded;<<#green>>

stop

@enduml
