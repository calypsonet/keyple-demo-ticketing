@startuml workflow-validation-2_fr
title Validation carte de stockage

start

:Présentation carte;

if (MIFARE Classic ?) then (Oui)
  :Authentification\nKEY_A secteur 1;
else (Non)
endif

:Lecture en une passe\nEnvironnement - Contrat+Compteur - Événement;

if (Env version=1 et\nEndDate valide ?) then (Non)
  :Carte invalide;<<#red>>
  stop
else (Oui)
endif

if (Event version=1 ?) then (Non)
  :Carte invalide;<<#red>>
  stop
else (Oui)
endif

if (Contract version=1\net EndDate valide ?) then (Non)
  :Carte invalide;<<#red>>
  stop
else (Oui)
endif

if (Compteur suffisant ?) then (Non)
  :Carte invalide;<<#red>>
  stop
else (Oui)
endif

:Écriture Contrat\nbloc 5;

:Écriture Événement\nbloc 6;

:Validation terminée;<<#green>>

stop

@enduml
