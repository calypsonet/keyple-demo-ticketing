@startuml workflow-validation-2
title Validation storage card

start

:Card presentation;

if (MIFARE Classic ?) then (Yes)
  :Authentication\nKEY_A sector 1;
else (No)
endif

:Single Pass Read\nEnvironment - Contract+Counter - Event;

if (Env version=1 and\nEndDate valid ?) then (No)
  :Invalid card;<<#red>>
  stop
else (Yes)
endif

if (Event version == 0 ?) then (Yes)
  :Empty card;<<#yellow>>
  stop
elseif (Event version == 1 ?) then (No)
  :Invalid card;<<#red>>
  stop
else (Yes)
endif

if (Anti-passback\nΔt <= 1 min ?) then (Yes)
  :Invalid card\n(already validated);<<#red>>
  stop
else (No)
endif

if (Contract version == 1 ?) then (No)
  :Invalid card;<<#red>>
  stop
else (Yes)
endif

if (Contract EndDate valid ?) then (No)
  :Expired ticket;<<#yellow>>
  stop
else (Yes)
endif

if (Ticket type ?) then (forbidden, expired\nor unknown)
  :Ticket forbidden\nor expired;<<#yellow>>
  stop
else (SEASON_PASS or\nMULTI_TRIP)
endif

if (MULTI_TRIP and\nCounter == 0 ?) then (Yes)
  :No trip left;<<#yellow>>
  stop
else (No)
endif

:Write contract\n(counter decremented if MULTI_TRIP);

:Write Event;

:Validation done;<<#green>>

stop

@enduml
