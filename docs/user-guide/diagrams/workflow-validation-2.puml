@startuml workflow-validation-2
title Validation of a storage card

start

:Card presentation;

if (MIFARE Classic ?) then (Yes)
  :Authentication\nof the sector;
else (No)
endif

:Read the environment,\nthe ticket and the event;

if (Card personalized\nand not expired ?) then (No)
  :Invalid card;<<#red>>
  stop
else (Yes)
endif

if (Card never loaded ?) then (Yes)
  :No valid ticket;<<#yellow>>
  stop
elseif (Last event of\na known version ?) then (No)
  :Invalid card;<<#red>>
  stop
else (Yes)
endif

if (Validated less than\n1 minute ago ?) then (Yes)
  :Invalid card\n(already validated);<<#red>>
  stop
else (No)
endif

if (Ticket of a\nknown version ?) then (No)
  :Invalid card;<<#red>>
  stop
else (Yes)
endif

if (Ticket expired ?) then (Yes)
  :Expired ticket;<<#yellow>>
  stop
else (No)
endif

if (Season pass or\nmulti-trip ticket ?) then (No)
  :Ticket forbidden\nor expired;<<#yellow>>
  stop
else (Yes)
endif

if (Multi-trip ticket\nwithout trips left ?) then (Yes)
  :No trip left;<<#yellow>>
  stop
else (No)
endif

:Write the ticket\n(1 trip debited for a multi-trip ticket);

:Write the validation event;

:Validation done;<<#green>>

stop

@enduml
