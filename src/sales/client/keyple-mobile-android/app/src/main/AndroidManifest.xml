                android:configChanges="orientation|keyboardHidden"
                android:exported="false">
        </activity>
        <activity
                android:name="org.calypsonet.keyple.demo.sales.ui.activities.CardMediumSettingsActivity"
                android:theme="@style/AppTheme.NoActionBar"
