<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ic_keyple_background_2">

    <include
        layout="@layout/toolbar"
        android:id="@+id/appBarLayout" />

    <TextView
        android:id="@+id/homeDescription"
        android:layout_width="@dimen/home_text_width"
        android:layout_height="wrap_content"
        android:text="@string/splash_title"
        style="@style/mediumRegularBlue"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Main operation first: loading of tickets, then personalization of a card (reset of its data) -->
    <LinearLayout
        android:id="@+id/loadTicketBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_card_btn_height"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/white_card"
        android:layout_marginHorizontal="@dimen/home_horizontal_margin"
        android:elevation="@dimen/elevation"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/homeDescription"
        app:layout_constraintBottom_toTopOf="@id/personalizeCardBtn"
        app:layout_constraintVertical_chainStyle="packed"
        android:gravity="center">

        <ImageView
            android:layout_width="@dimen/home_icon_size"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:contentDescription="@string/home_load_tickets"
            android:src="@drawable/ic_load_tickets"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_selection_top_margin"
            android:text="@string/home_load_tickets"
            style="@style/bigBoldDarkBlue" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/personalizeCardBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_card_btn_height"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/white_card"
        android:layout_marginHorizontal="@dimen/home_horizontal_margin"
        android:elevation="@dimen/elevation"
        android:layout_marginTop="@dimen/home_btn_top_margin"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loadTicketBtn"
        app:layout_constraintBottom_toTopOf="@id/eclipseLogo"
        android:gravity="center">

        <ImageView
            android:layout_width="@dimen/home_icon_size"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:contentDescription="@string/home_personalize_card"
            android:src="@drawable/ic_personalize_card"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_selection_top_margin"
            android:text="@string/home_personalize_card"
            style="@style/bigBoldDarkBlue" />
    </LinearLayout>

    <!-- Version of the application, in the bottom right corner as in the other applications of the demo -->
    <TextView
        android:id="@+id/versionName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:text="@string/version"
        android:textColor="@color/dark_blue"
        android:textSize="@dimen/version"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageView
        android:id="@+id/eclipseLogo"
        android:layout_width="@dimen/eclipse_logo_width"
        android:layout_height="@dimen/eclipse_logo_height"
        android:src="@drawable/ic_logo_calypso"
        android:scaleType="center"
        android:background="@android:color/transparent"
        android:contentDescription="@string/eclipse_foundation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="@dimen/home_element_margin" />
</androidx.constraintlayout.widget.ConstraintLayout>
