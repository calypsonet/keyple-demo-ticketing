###############################
# Git Line Endings            #
###############################

* text=auto

# CRLF for Windows files.
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf
*.cs                 text diff=csharp

# LF for Linux files.
*.sh text eol=lf

# Common files
*.java   text eol=lf diff=java
*.html   text eol=lf diff=html
*.css    text eol=lf
*.js     text eol=lf
*.sql    text eol=lf
*.kts    text eol=lf
*.gradle.kts text eol=lf

###############################
# Binary files                #
###############################

# Archives
*.7z binary
*.br binary
*.gz binary
*.jar binary
*.tar binary
*.zip binary

# Documents
*.pdf binary
*.docx binary diff=astextplain

# Images
*.gif binary
*.ico binary
*.jpg binary
*.png binary
*.psd binary
*.webp binary

# Fonts
*.woff2 binary

# Other
*.exe binary
